{
  "name": "platform",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @repo/shared build && pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm --filter @repo/shared build && pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "oxlint apps packages",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "oxlint": "^1.93.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3"
  }
}
