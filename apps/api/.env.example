# Copy to apps/api/.env for local development. Never commit real values.
NODE_ENV=development
PORT=4000
# Comma-separated list of exact origins (web, mini-app).
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
SWAGGER_ENABLED=true

# PostgreSQL. Local: infrastructure/docker-compose.yml. Supabase: Project Settings → Database → Connect.
# Runtime pool (Supabase: the session pooler URL is fine for a long-running server).
DATABASE_URL=postgresql://platform:platform@localhost:5432/platform
# Direct connection for `prisma migrate` (Supabase: the direct / port 5432 URL).
DIRECT_URL=postgresql://platform:platform@localhost:5432/platform

# Database for the integration test suite (test/db.spec.ts). Its name must end in "_test":
# the suite drops and rebuilds the "app" schema there. Leave unset to skip DB tests.
TEST_DATABASE_URL=postgresql://platform:platform@localhost:5432/platform_test

# Optional: `pnpm --filter @repo/api db:seed` grants SUPER_ADMIN to this email.
# SEED_SUPER_ADMIN_EMAIL=

# Supabase Auth (Project Settings → API). The API verifies Supabase access tokens via the project's JWKS.
SUPABASE_URL=http://127.0.0.1:54321
# Only if the project still uses the legacy HS256 "JWT secret" (leave unset with asymmetric signing keys).
# SUPABASE_JWT_SECRET=

# Rate limiting and proxy.
THROTTLE_LIMIT=120
# Set true behind a reverse proxy so client IPs come from X-Forwarded-For.
TRUST_PROXY=false
INVITATION_TTL_DAYS=7
